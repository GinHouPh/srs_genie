# ----------------------------------------------------------------------
# SRS Genie - Apache Configuration (.htaccess) for Serverbyt / StackCP
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Forward API calls to PHP handlers
  RewriteRule ^api/health$ api/health.php [L,QSA]
  RewriteRule ^api/auth(/.*)?$ api/auth.php [L,QSA]
  RewriteRule ^api/projects(/.*)?$ api/projects.php [L,QSA]
  RewriteRule ^api/saas(/.*)?$ api/saas.php [L,QSA]
  RewriteRule ^api/cashfree(/.*)?$ api/cashfree.php [L,QSA]

  # 2. Prevent directory listing
  Options -Indexes

  # 3. Handle Single Page Application (React Router / HTML5 History)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# Security & MIME Types
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/font-woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
